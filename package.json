{
  "name": "black-sales-ai",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run build && concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "build": "vite build && node scripts/check-client-boundary.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db:concurrency": "node scripts/test-site-persistence-concurrency.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src server shared tests scripts docs \"*.json\" \"*.ts\" \"*.md\"",
    "format:check": "prettier --check src server shared tests scripts docs \"*.json\" \"*.ts\" \"*.md\"",
    "check": "npm run typecheck && npm test && npm run build",
    "preview:local": "wrangler dev --local --ip 127.0.0.1 --port 8787"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "hono": "4.13.14",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@electric-sql/pglite": "0.5.13",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
