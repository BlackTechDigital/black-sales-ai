{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "node",
      "@cloudflare/workers-types",
      "vitest/globals"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "server", "shared", "tests", "*.ts"]
}
